# Copier en .env puis adapter. Ne jamais committer le .env.
# Clé : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Développement local ---
DJANGO_SECRET_KEY=remplacer-par-une-cle-aleatoire
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS=false
DJANGO_HSTS_SECONDS=0

# --- Base de données (lue par settings.py) ---
# DB_NAME vide ou absent : SQLite (db.sqlite3), les autres DB_* sont ignorées.
# DB_ENGINE : mysql (MySQL/MariaDB, défaut, pilote PyMySQL) ou postgresql.
# DB_HOST : 127.0.0.1 plutôt que localhost (le conteneur n'écoute qu'en IPv4).
# DB_PORT : 3306 par défaut pour mysql, 5432 pour postgresql.
#
# Développement local : MariaDB 11.4 dans Docker (docker compose up -d mariadb, voir README).
# Les mots de passe sont libres en local, choisis avant le premier démarrage du conteneur
# (ils sont figés à la création du volume).
DB_ENGINE=mysql
DB_NAME=egmtech_suivi
DB_USER=egmtech
DB_PASSWORD=remplacer-par-un-mot-de-passe-local
DB_HOST=127.0.0.1
DB_PORT=3306
# Lu uniquement par docker-compose.yml (compte root du conteneur MariaDB), pas par Django.
MARIADB_ROOT_PASSWORD=remplacer-par-un-autre-mot-de-passe-local

# PostgreSQL (14+) : DB_ENGINE=postgresql, DB_PORT=5432, base et utilisateur créés à la main.
# Production : valeurs fournies par l'hébergeur (voir docs/EXPLOITATION.md, section 8).

# --- Production (suivi.egmtech.co) : remplacer le bloc ci-dessus par celui-ci, sans les « # » ---
# DJANGO_SECRET_KEY=<cle generee avec la commande ci-dessus>
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=suivi.egmtech.co
# DJANGO_CSRF_TRUSTED_ORIGINS=https://suivi.egmtech.co
# Passer DJANGO_HTTPS a true une fois le certificat SSL valide (AutoSSL),
# puis DJANGO_HSTS_SECONDS a 3600, et 31536000 quand tout est stable.
# DJANGO_HTTPS=false
# DJANGO_HSTS_SECONDS=0
