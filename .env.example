# Copier en .env puis adapter. Ne jamais committer le .env.
# Clé : python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Développement local ---
DJANGO_SECRET_KEY=remplacer-par-une-cle-aleatoire
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS=false
DJANGO_HSTS_SECONDS=0

# --- Base de données PostgreSQL ---
# Laisser DB_NAME vide (ou absent) pour revenir à SQLite (db.sqlite3).
DB_NAME=cp2863635p37_suivi
DB_USER=cp2863635p37_suivi_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Serveur en PostgreSQL 10 à 13 (Django 5.2 exige 14+) : mettre true le temps des tests,
# en attendant la mise à jour de PostgreSQL par l'hébergeur.
DB_POSTGRES_ANCIEN=false

# --- Production (suivi.egmtech.co) : remplacer le bloc ci-dessus par celui-ci, sans les « # » ---
# DJANGO_SECRET_KEY=<cle generee avec la commande ci-dessus>
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=suivi.egmtech.co
# DJANGO_CSRF_TRUSTED_ORIGINS=https://suivi.egmtech.co
# Passer DJANGO_HTTPS a true une fois le certificat SSL valide (AutoSSL),
# puis DJANGO_HSTS_SECONDS a 3600, et 31536000 quand tout est stable.
# DJANGO_HTTPS=false
# DJANGO_HSTS_SECONDS=0
